# Fabrexa AI environment configuration
# Copy this file to .env, replace the placeholder values, and never commit .env.

# Telegram
# Create a bot token with @BotFather. Required.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Numeric Telegram user ID. Required when BOT_PRIVATE is true.
OWNER_ID=123456789

# Public Telegram username shown to users who request access in private mode.
# The leading @ is optional. Required when BOT_PRIVATE is true.
OWNER_USERNAME=your_telegram_username

# true: only OWNER_ID can use the bot
# false: any Telegram user can use the bot
BOT_PRIVATE=true

# Ollama
# Base Ollama server URL. Do not add /api/chat here.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat model name as shown by `ollama list`.
OLLAMA_MODEL=gemma3:12b

# Optional separate model for memory analysis. Leave empty to use OLLAMA_MODEL.
OLLAMA_ANALYZER_MODEL=

# How long Ollama keeps a model loaded, for example 5m, 10m, or 1h.
OLLAMA_KEEP_ALIVE=10m

# Generation
# Context window size in tokens. Must be a positive number.
OLLAMA_NUM_CTX=8192

# Sampling temperature. Must be greater than 0 with the current config parser.
OLLAMA_TEMPERATURE=0.8

# Nucleus sampling value. Must be greater than 0.
OLLAMA_TOP_P=0.9

# Maximum number of tokens generated for one response.
OLLAMA_MAX_TOKENS=2048

# Minimum combined response length. The bot asks Ollama to continue when a
# response ends below this target. Set to 0 to disable automatic continuation.
OLLAMA_MIN_RESPONSE_WORDS=250

# Maximum extra Ollama requests used to reach the minimum response length.
OLLAMA_MAX_CONTINUATIONS=2

# Maximum number of previous conversation messages considered for each reply.
CHAT_HISTORY_MAX_MESSAGES=24

# Approximate token budget for previous conversation messages. The bot may use
# less when the system prompt, long-term memory, or latest message needs space.
CHAT_HISTORY_MAX_TOKENS=4096

# Final instruction appended after every selected personality prompt. Keeping it
# last gives shared response rules priority over conflicting personality text.
PERSONALITY_INSTRUCTION="Follow the selected personality and always respond with a substantial, fully developed answer."

# Requests and Telegram streaming
# Ollama request timeout in milliseconds.
REQUEST_TIMEOUT=120000

# Minimum interval between Telegram streaming message edits, in milliseconds.
TELEGRAM_STREAM_EDIT_INTERVAL_MS=6000

# Memory
# Comma-separated personality file keys or display names allowed to use memory.
# Friendly and Vent Girl use memory by default. Leave empty to disable memory.
MEMORY_ENABLED_PERSONALITIES=Friendly,Vent Girl

# Cron schedule for promoting eligible short-term memories to long-term memory.
MEMORY_PROCESSOR_CRON="0 0 * * *"

# IANA timezone used by the memory processor schedule.
MEMORY_PROCESSOR_TIMEZONE=Asia/Tehran

# Logging
# normal keeps logs concise. dev-mode, debug, or verbose enables payload diagnostics.
LOG_MODE=normal

# Configured log level. Defaults to INFO.
LOG_LEVEL=INFO
